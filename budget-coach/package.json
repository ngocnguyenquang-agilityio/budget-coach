{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "pnpm run dev:infra && concurrently \"pnpm run dev:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:agent": "mastra dev",
    "dev:ui": "next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug pnpm run dev",
    "build": "next build",
    "start": "next start",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs",
    "seed": "tsx scripts/seed-db.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/mastra": "1.1.1",
    "@ai-sdk/openai": "^4.0.32",
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@copilotkit/react-core": "1.65.0",
    "@copilotkit/runtime": "1.65.0",
    "@libsql/client": "^0.15.15",
    "@mastra/client-js": "1.38.0",
    "@mastra/core": "1.57.0",
    "@mastra/libsql": "1.19.0",
    "@mastra/memory": "1.26.0",
    "@mastra/observability": "1.16.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "libsql": "^0.5.22",
    "lucide-react": "^1.28.0",
    "mastra": "1.23.0",
    "next": "16.1.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/encoder": "0.0.57",
    "@ag-ui/proto": "0.0.57"
  }
}
