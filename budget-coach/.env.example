# Model provider (Cerebras)
CEREBRAS_API_KEY=          # required — get one at cloud.cerebras.ai

# Authentication (Clerk) — required; keys from dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # required — pk_test_… / pk_live_…
CLERK_SECRET_KEY=                    # required — sk_test_… / sk_live_…

# Database (defaults to a local file if unset)
TURSO_DATABASE_URL=        # default: file:./budget-coach.db
TURSO_AUTH_TOKEN=          # required only when TURSO_DATABASE_URL points at a hosted Turso DB

# Logging
LOG_LEVEL=                 # default: info

# No CopilotKit Intelligence variables are needed. Durable thread history comes
# from Mastra memory in LibSQL (see src/mastra/threads.ts), which works the same
# locally and on serverless. COPILOTKIT_LICENSE_TOKEN and INTELLIGENCE_* are read
# nowhere in this app — setting them changes nothing.
