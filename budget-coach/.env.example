# Model provider (defaults to local Ollama if unset)
MODEL_PROVIDER=            # set to "google" to use Gemini instead of Ollama
OLLAMA_BASE_URL=           # default: http://localhost:11434/v1
OLLAMA_MODEL=              # default: llama3.1

# Database (defaults to a local file if unset)
TURSO_DATABASE_URL=        # default: file:./budget-coach.db
TURSO_AUTH_TOKEN=          # required only when TURSO_DATABASE_URL points at a hosted Turso DB

# Logging
LOG_LEVEL=                 # default: info

# CopilotKit Intelligence (optional, enables durable threads) — see .env
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
COPILOTKIT_LICENSE_TOKEN=
INTELLIGENCE_API_KEY=
